NODE_ENV=development
PORT=7788
MONGO_URI=mongodb://127.0.0.1:27027/ivy-api-dev

CLIENT_JWT_SECRET=dev-client-secret-change-me
CLIENT_JWT_EXPIRES_IN=30d
ADMIN_JWT_SECRET=dev-admin-secret-change-me
ADMIN_JWT_EXPIRES_IN=1d

UPLOADER_BASE_URL=https://uploader.example.com/api
UPLOADER_ALLOWED_IMAGE_PREFIXES=

# Email and Google settings live in this JSON file.
AUTH_PROVIDERS_CONFIG=./config/auth.providers.json

ADMIN_USER=admin
ADMIN_PASSWORD=admin

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
