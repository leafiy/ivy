ivy-api.leafiy.com {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy 127.0.0.1:7788
}

ivy.leafiy.com {
    encode zstd gzip

    # A world-readable tree of its own, not the API release directory: that one
    # lives under /root at mode 0700, where Caddy cannot follow. The symlink is
    # swapped on deploy, so Caddy needs no reconfiguring.
    root * /srv/ivy-web/current

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # The client talks to ivy-api.leafiy.com and to the uploader, and
        # renders images served from OSS. Everything else is refused, and
        # nothing may frame this page.
        Content-Security-Policy "default-src 'self'; connect-src 'self' https://ivy-api.leafiy.com https://uploader.qiansmile.com; img-src 'self' data: https://files.qiansmile.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'none'"
    }

    # Hashed asset filenames are immutable, so they can be cached hard. The
    # entry document never is, or a deploy would not reach anyone still holding
    # the old one.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    header /index.html Cache-Control "no-cache"

    # The app owns its own routing, so an unknown path is a deep link into it,
    # not a missing file. Real asset requests still 404 rather than being
    # answered with HTML, which would only produce a confusing MIME error.
    handle {
        try_files {path} /index.html
        file_server
    }
}
